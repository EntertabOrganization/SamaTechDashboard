# Origin of the SamaTechs backend (SamaTechBackend), without a trailing /api.
# Read at build time, so rebuild after changing it. Defaults to http://localhost:4000.
# The backend keeps the session in a cookie, so in production serve the dashboard
# and the API from the same site (e.g. dashboard.samatechs.com and api.samatechs.com).
NEXT_PUBLIC_API_URL=http://localhost:4000

# The public website, for "View website" and "Back to website". Defaults to http://localhost:3000.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
